# Copy this file to deploy/.env.production on the server.
# Never commit deploy/.env.production.

VIRAL_AI_DOMAIN=api.example.com

VIRAL_AI_ENV=production
VIRAL_AI_STATE_DRIVER=sqlite
VIRAL_AI_TRUST_PROXY=true

# First boot only. Remove VIRAL_AI_BOOTSTRAP_PASSWORD after owner login succeeds.
VIRAL_AI_BOOTSTRAP_EMAIL=owner@example.com
VIRAL_AI_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
VIRAL_AI_BOOTSTRAP_NAME=Account Owner
VIRAL_AI_BOOTSTRAP_PLAN=creator_pro

# Separate operator secrets, each at least 32 random characters.
VIRAL_AI_OPERATIONS_TOKEN=replace-with-long-random-operations-token
VIRAL_AI_ADMIN_TOKEN=replace-with-long-random-admin-token

# Current Cloud Speech, Translation and Voice providers all use the same
# server-side OpenAI credential. Never put this key in the desktop app.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
VIRAL_AI_OPENAI_TRANSCRIBE_MODEL=whisper-1
VIRAL_AI_OPENAI_TRANSLATION_MODEL=gpt-5-mini
VIRAL_AI_OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Billing may stay unconfigured for Private Commercial / Early Access.
VIRAL_AI_BILLING_PROVIDER=unconfigured
VIRAL_AI_BILLING_WEBHOOK_SECRET=
