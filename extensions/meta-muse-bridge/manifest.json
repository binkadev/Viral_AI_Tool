{
  "manifest_version": 3,
  "name": "Viral AI · Meta Muse Bridge",
  "version": "0.3.1",
  "description": "Muse session readiness for Viral AI Tool.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://muse.ai/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "service-worker.js"},
  "content_scripts": [{"matches": ["https://muse.ai/*"], "js": ["receipt-v2.js", "content-script.js"], "run_at": "document_idle"}],
  "action": {"default_title": "Viral AI · Meta Muse Bridge", "default_popup": "popup.html"}
}
