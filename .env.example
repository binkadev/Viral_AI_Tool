# Viral AI Tool backend environment example
# Copy to your secret manager / deployment environment. Do not commit real values.

VIRAL_AI_ENV=production
VIRAL_AI_STATE_DRIVER=sqlite
VIRAL_AI_DEV_PORT=3000
# Keep 127.0.0.1 for a host process behind a local reverse proxy.
# Use 0.0.0.0 only inside a container/network boundary where the host port remains private.
VIRAL_AI_BIND_HOST=127.0.0.1
VIRAL_AI_DEV_DATA_DIR=/var/lib/viral-ai-tool

# SQLite online backup destination and retention.
VIRAL_AI_BACKUP_DIR=/var/backups/viral-ai-tool
VIRAL_AI_BACKUP_KEEP=14

# Set true only when the backend is reachable exclusively through your trusted reverse proxy.
VIRAL_AI_TRUST_PROXY=true

# Optional protected operations endpoint. Use a random value of at least 32 characters.
VIRAL_AI_OPERATIONS_TOKEN=replace-with-a-long-random-operations-token

# Operator-only account provisioning. Never embed this token in the desktop app.
# Use a different random value of at least 32 characters.
VIRAL_AI_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# First production boot only. Remove the password from the environment after verifying access.
VIRAL_AI_BOOTSTRAP_EMAIL=owner@example.com
VIRAL_AI_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
VIRAL_AI_BOOTSTRAP_NAME=Account Owner
VIRAL_AI_BOOTSTRAP_PLAN=free

# Production billing provider identifier. This is informational until a real
# provider adapter is implemented and registered in the backend.
VIRAL_AI_BILLING_PROVIDER=unconfigured

# Required when using signed billing lifecycle events.
VIRAL_AI_BILLING_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Current Cloud Speech, Translation, Voice and Automation Script providers use
# server-side OpenAI-compatible credentials. Never put this key in the renderer.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
VIRAL_AI_OPENAI_TRANSCRIBE_MODEL=whisper-1
VIRAL_AI_OPENAI_TRANSLATION_MODEL=gpt-5-mini
VIRAL_AI_OPENAI_SCRIPT_MODEL=gpt-5-mini
VIRAL_AI_OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Development-only Automation Script fallback. This produces a deterministic,
# offline template so the project/job/UI/persistence flow can be tested without
# an external API key. Leave disabled in production builds/deployments.
VIRAL_AI_AUTOMATION_DEV_PROVIDER=0

# Automation stock footage. PEXELS_API_KEY stays in the Electron main/backend
# boundary and is never exposed to renderer project state.
PEXELS_API_KEY=

# Development-only stock provider. Generates a local FFmpeg test clip so the
# AssetRouter/cache/materialization flow can be verified without a stock API key.
# Leave disabled in production builds/deployments.
VIRAL_AI_AUTOMATION_DEV_STOCK_PROVIDER=0
