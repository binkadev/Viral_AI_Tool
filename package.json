{
  "name": "viral-ai-tool",
  "version": "0.7.0",
  "description": "Viral AI Tool desktop video automation studio",
  "main": "main.js",
  "author": "Viral AI Tool",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.viralai.tool",
    "productName": "Viral AI Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "services/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Viral AI Tool"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**",
      "services/speech/local-worker.js"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "sherpa-onnx-node": "1.13.8",
    "sherpa-onnx-win-x64": "1.13.8"
  }
}
